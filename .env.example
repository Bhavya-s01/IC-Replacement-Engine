# Copy to .env and fill in. Never commit .env.

# LLM used to extract specs from datasheets (any OpenAI-compatible endpoint).
# Example: Google Gemini free tier
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.1-flash-lite
LLM_API_KEY=your_key_here

# Optional fallback provider (NVIDIA NIM)
# NVIDIA_API_KEY=nvapi-your_key_here
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# Required to use /api/admin/* from any machine other than localhost
# ADMIN_TOKEN=choose-a-long-random-string

# Optional: database location (default ic_database.db)
# IC_DB_PATH=ic_database.db
